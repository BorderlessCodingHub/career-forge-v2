# Career Forge — local dev (copy to .env)

# Postgres (local defaults)
POSTGRES_USER=careerforge
POSTGRES_PASSWORD=careerforge
POSTGRES_DB=careerforge

# Backend
BACKEND_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://careerforge:careerforge@localhost:5432/careerforge
# Must include every browser origin (match WEB_HOST_PORT)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3300,http://127.0.0.1:3300
ENV=local
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
# Host URL for the Next app (port must match WEB_HOST_PORT). basePath is /career-forge.
FRONTEND_URL=http://localhost:3300/career-forge
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_USER_ID=demo-ana
API_INTERNAL_URL=http://localhost:8000
WEB_HOST_PORT=3300

# Demo seed (docker backend startup)
SEED_DEMO_ANA=true

# AI — required for diagnosis interview (OpenAI)
OPENAI_API_KEY=
# OpenAI native web_search model for Roadmap Forge research_enrich
FORGE_SEARCH_MODEL=gpt-5.4
FORGE_PLANNER_MODEL=gpt-5.4
FORGE_EVALUATOR_MODEL=gpt-5.4-mini
FORGE_STREAM_DELAY_SEC=1.5
# Fast nano model for Judge + Interviewer (override: gpt-5-nano, gpt-5.4-nano, etc.)
DIAGNOSIS_INTERVIEW_MODEL=gpt-4.1-nano
MOCK_INTERVIEW_MODEL=gpt-5.4-mini

# Auth scaffold (CAR-23 / ADR-003) — anon JWT HS256; change in any shared deploy
JWT_SECRET=career-forge-dev-jwt-secret-change-me-32b+
JWT_ANON_TTL_DAYS=90
# CAR-26 — forge SSE stream ticket TTL (seconds)
JWT_STREAM_TICKET_TTL_SECONDS=300

# Cost instrumentation (CAR-6/CAR-7) — global pool hard stop + per-user forge cap
# Proxy = runs × COST_P95_BRL_PER_RUN × COST_BUFFER_FACTOR
# P95 from F2 re-cost (docs/reports/2026-08-06-cost-gate.md): forge P95 = R$1.3639 (CAR-33)
MONTHLY_API_BUDGET_BRL=500
FORGE_CAP_PER_USER_MONTH=2
COST_P95_BRL_PER_RUN=1.3639
COST_BUFFER_FACTOR=1.10
# Fixed FX for CAR-7 report / kill-switch docs (USD → BRL)
COST_FX_USD_BRL=5.50

# Soft gate (CAR-15) — provisional; retune on golden cases (CAR-18)
# Fires lean forge when profile_score (mean of 5 dim confidences) < cutoff
SOFT_GATE_CUTOFF=0.50

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=career-forge
LANGCHAIN_TRACING_V2=true

# Linear MCP (Cursor Cloud / Mobile Bearer auth — set in Cloud secrets; optional locally)
# Optional legacy Linear Bearer MCP — prefer Cursor Linear plugin
# LINEAR_API_KEY=
